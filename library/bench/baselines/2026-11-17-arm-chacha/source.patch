+// ChaCha20-Poly1305 records use a fixed key/nonce and 13 bytes of AAD, as in
+// the benchmark setup. The record is all-zero plaintext, sealed in one call.
+const chachaKey = Buffer.from([...Array(32).keys()]);
+const chachaNonce = Buffer.from([...Array(12).keys()]);
+const chachaAad = Buffer.alloc(13);
+const chachaRows = [16, 512, 4096, 16384].map(size => {
+    const cipher = createCipheriv('chacha20-poly1305', chachaKey, chachaNonce,
+        { authTagLength: 16 });
+    cipher.setAAD(chachaAad);
+    const bytes = Buffer.concat([cipher.update(Buffer.alloc(size)), cipher.final()]);
+    const tag = cipher.getAuthTag();
+    const array = data => `{${[...data].join(',')}}`;
+    return `{${checksum(bytes.subarray(-Math.min(size, 512)))}UL,${array(tag)}}`;
+});
