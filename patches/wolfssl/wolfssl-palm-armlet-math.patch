+    static int Transform_Sha256_Len(wc_Sha256* sha256, const byte* data,
+        word32 len)
+    {
+        while (len >= WC_SHA256_BLOCK_SIZE) {
+            word32 blocks = len / WC_SHA256_BLOCK_SIZE;
+            word32 index;
+            if (blocks > 8)
+                blocks = 8;
+            if (PalmTlsArmletSha256Transform(sha256->digest, data, blocks) == 0) {
+                data += blocks * WC_SHA256_BLOCK_SIZE;
+                len -= blocks * WC_SHA256_BLOCK_SIZE;
+                continue;
+            }
+            for (index = 0; index < blocks; index++) {
+                int ret = Transform_Sha256(sha256,
+                    data + index * WC_SHA256_BLOCK_SIZE);
+                if (ret != 0)
+                    return ret;
+            }
+            data += blocks * WC_SHA256_BLOCK_SIZE;
+            len -= blocks * WC_SHA256_BLOCK_SIZE;
+        }
+        return 0;
+    }
+    #define XTRANSFORM_LEN(S, D, L) Transform_Sha256_Len((S), (D), (L))
+#endif
 #endif
 /* End wc_ software implementation */

