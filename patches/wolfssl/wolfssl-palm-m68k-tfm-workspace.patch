+
+/* Store the staged result after all operand reads, including aliased inputs. */
+static void PalmStoreComba(fp_int* result, const fp_digit* words, int used,
+    int sign)
+{
+    fp_digit* tail = result->dp + used;
+    unsigned int remaining = FP_SIZE - used;
+    unsigned int blocks = remaining / 16;
+
+    result->used = used;
+    result->sign = sign;
+    XMEMCPY(result->dp, words, used * sizeof(fp_digit));
+    /* Preserve zero extension while clearing 16 words per loop. */
+    if (blocks != 0) {
+        --blocks;
+        __asm__ volatile(
+            "1: .rept 8\n\t"
+            "move.l %[zero],(%[tail])+\n\t"
+            ".endr\n\t"
+            "dbra %[blocks],1b"
+            : [tail] "+&a"(tail), [blocks] "+&d"(blocks)
+            : [zero] "d"((fp_word)0) : "cc", "memory");
+    }
+    XMEMSET(tail, 0, (remaining % 16) * sizeof(fp_digit));
+    fp_clamp(result);
+}
+#endif
