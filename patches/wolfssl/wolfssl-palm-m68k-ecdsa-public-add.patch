+static int PalmPublicIsInfinity(const ecc_point* point)
+{
+    return mp_iszero(point->x) && mp_iszero(point->y);
+}
+
+/* Public-only addition. The raw formula supports result == left and
+ * represents a missed double by (0,0,0) and opposite points by Z == 0. */
+static int PalmPublicAdd(ecc_point* left, ecc_point* right, ecc_point* result,
+    mp_int* a, mp_int* modulus, mp_digit mp)
+{
+    int err;
+    if (PalmPublicIsInfinity(left))
+        return wc_ecc_copy_point(right, result);
+    if (PalmPublicIsInfinity(right))
+        return wc_ecc_copy_point(left, result);
+    /* The raw formula doubles equal X/Z and opposite Y. */
+    if (mp_cmp(left->x, right->x) == MP_EQ &&
+        mp_cmp(left->z, right->z) == MP_EQ &&
+        mp_cmp(left->y, right->y) != MP_EQ)
+        return ecc_set_point_infinity(result);
+
+    err = _ecc_projective_add_point(left, right, result, a, modulus, mp);
+    if (err == MP_OKAY && mp_iszero(result->z)) {
+        if (PalmPublicIsInfinity(result))
+            return ecc_projective_dbl_point_safe(right, result, a, modulus, mp);
+        return ecc_set_point_infinity(result);
+    }
+    return err;
+}
