+#ifdef PALM_TFM_68K
+static void PalmAddMod16(const fp_digit* a, const fp_digit* b,
+    const fp_digit* modulus, fp_digit* result)
+{
+    fp_digit reduced[16];
+    fp_digit word, other, count = 15, carry = 0, borrow, mask;
+    fp_digit* dst = result;
+    int i;
+
+    /* Sum the words into result, retaining the carry out. */
+    __asm__ volatile(
+        "add.w %[carry],%[carry]\n"
+        "1: move.w (%[a])+,%[word]\n\t"
+        "move.w (%[b])+,%[other]\n\t"
+        "addx.w %[other],%[word]\n\t"
+        "move.w %[word],(%[dst])+\n\t"
+        "dbra %[count],1b\n\t"
+        "addx.w %[carry],%[carry]"
+        : [a] "+&a"(a), [b] "+&a"(b), [dst] "+&a"(dst),
+          [word] "=&d"(word), [other] "=&d"(other),
+          [count] "+&d"(count), [carry] "+&d"(carry)
+        : : "cc", "memory");
+
+    /* Compute the candidate reduction and a mask from its borrow out. */
+    count = 15;
+    dst = reduced;
+    const fp_digit* sum = result;
+    __asm__ volatile(
+        "moveq #0,%[borrow]\n\t"
+        "sub.w %[borrow],%[borrow]\n"
+        "1: move.w (%[sum])+,%[word]\n\t"
+        "move.w (%[modulus])+,%[borrow]\n\t"
+        "subx.w %[borrow],%[word]\n\t"
+        "move.w %[word],(%[dst])+\n\t"
+        "dbra %[count],1b\n\t"
+        "subx.w %[borrow],%[borrow]"
+        : [sum] "+&a"(sum), [modulus] "+&a"(modulus), [dst] "+&a"(dst),
+          [word] "=&d"(word), [borrow] "=&d"(borrow), [count] "+&d"(count)
+        : : "cc", "memory");
+
+    mask = (fp_digit)(0 - carry) | (fp_digit)~borrow;
+    for (i = 0; i < 16; i++)
+        result[i] ^= (result[i] ^ reduced[i]) & mask;
+}
+#endif
