+/* Each column scans one operand forward and the other backward. Mode is
+ * constant at the call site and selects one or two adds for each product. */
+static WC_INLINE __attribute__((always_inline)) void PalmCombaColumn(
+    const fp_digit* left, const fp_digit* right, int count,
+    fp_word* lo, fp_digit* hi, int twice)
+{
+    fp_word product;
+
+    if (count <= 0)
+        return;
+    --count;
+    ++right;
+    #define PALM_COMBA_ADD \
+        "add.l %[product],%[lo]\n\t" \
+        "addx.w %[zero],%[hi]\n\t"
+    #define PALM_COMBA_COLUMN(accumulate) \
+        __asm__ ( \
+            "1: move.w (%[left])+,%[product]\n\t" \
+            "mulu.w -(%[right]),%[product]\n\t" \
+            accumulate \
+            "dbra %[count],1b" \
+            : [left] "+&a"(left), [right] "+&a"(right), [count] "+&d"(count), \
+              [lo] "+&d"(*lo), [hi] "+&d"(*hi), [product] "=&d"(product) \
+            : [zero] "d"((fp_digit)0) : "cc", "memory")
+    if (twice) {
+        PALM_COMBA_COLUMN(PALM_COMBA_ADD PALM_COMBA_ADD);
+    }
+    else {
+        PALM_COMBA_COLUMN(PALM_COMBA_ADD);
+    }
+    #undef PALM_COMBA_COLUMN
+    #undef PALM_COMBA_ADD
+}
