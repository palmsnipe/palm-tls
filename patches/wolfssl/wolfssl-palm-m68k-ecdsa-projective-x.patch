+/* X/Z^2 agrees with r modulo n iff X equals r*Z^2 or (r+n)*Z^2 in
+ * the field. P-256 has n < p < 2n, so there are at most two candidates.
+ * Z^2 is in Montgomery form, as is the product by an ordinary scalar. */
+static int PalmPublicCheckX(ecc_point* point, mp_int* r, mp_int* order,
+    mp_int* modulus, mp_digit mp, int* verified)
+{
+    int err;
+    if (PalmPublicIsInfinity(point) || mp_iszero(point->z))
+        return MP_OKAY;
+    err = PalmPublicSquare(point->z, point->z, modulus, mp);
+    if (err == MP_OKAY)
+        err = mp_mulmod(r, point->z, modulus, point->y);
+    if (err != MP_OKAY)
+        return err;
+    if (mp_cmp(point->x, point->y) == MP_EQ) {
+        *verified = 1;
+        return MP_OKAY;
+    }
+    err = mp_add(r, order, point->y);
+    if (err != MP_OKAY || mp_cmp(point->y, modulus) != MP_LT)
+        return err;
+    err = mp_mulmod(point->y, point->z, modulus, point->y);
+    if (err == MP_OKAY && mp_cmp(point->x, point->y) == MP_EQ)
+        *verified = 1;
+    return err;
+}
