-            "1: .rept 8\n\t"
-            "move.l %[zero],(%[tail])+\n\t"
-            ".endr\n\t"
-            "dbra %[blocks],1b"
-            : [tail] "+&a"(tail), [blocks] "+&d"(blocks)
-            : [zero] "d"((fp_word)0) : "cc", "memory");
-    }
-    XMEMSET(tail, 0, (remaining % 16) * sizeof(fp_digit));
+    PalmClearDigits(result->dp + used, FP_SIZE - used);
     fp_clamp(result);
 }
 #endif
