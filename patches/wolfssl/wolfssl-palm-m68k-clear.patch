+#ifdef PALM_TFM_68K
+/* The compiler ABI aligns digits for both word and long accesses. */
+static void PalmClearDigits(fp_digit* digits, unsigned int count)
+{
+    unsigned int blocks = count / 16;
+    if (blocks != 0) {
+        --blocks;
+        __asm__ volatile(
+            "1: .rept 8\n\t"
+            "move.l %[zero],(%[digits])+\n\t"
+            ".endr\n\t"
+            "dbra %[blocks],1b"
+            : [digits] "+&a"(digits), [blocks] "+&d"(blocks)
+            : [zero] "d"((fp_word)0) : "cc", "memory");
+    }
+    XMEMSET(digits, 0, (count % 16) * sizeof(fp_digit));
+}
+#endif
+
