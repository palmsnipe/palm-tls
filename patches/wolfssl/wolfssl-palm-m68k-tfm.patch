+#if defined(PALM_TFM_68K)
+/* Use the 68000 extend flag to carry the borrow across 16-bit digits.
+ * MOVE, AND and DBRA leave X intact. All inner loop counts are fixed. */
+static void PalmSubMod16(const fp_digit* a, const fp_digit* b,
+    const fp_digit* modulus, fp_digit* result)
+{
+    fp_digit term, borrow, value, count = 15;
+    fp_digit* dst = result;
+
+    __asm__ volatile(
+        "moveq #0,%[borrow]\n\t"
+        "add.w %[borrow],%[borrow]\n"
+        "1: move.w (%[a])+,%[term]\n\t"
+        "move.w (%[b])+,%[borrow]\n\t"
+        "subx.w %[borrow],%[term]\n\t"
+        "move.w %[term],(%[dst])+\n\t"
+        "dbra %[count],1b\n\t"
+        "move.w (%[a]),%[term]\n\t"
+        "move.w (%[b]),%[borrow]\n\t"
+        "subx.w %[borrow],%[term]\n\t"
+        "subx.w %[borrow],%[borrow]"
+        : [a] "+&a"(a), [b] "+&a"(b), [dst] "+&a"(dst),
+          [count] "+&d"(count), [term] "=&d"(term), [borrow] "=&d"(borrow)
+        : : "cc", "memory");
+
+    count = 15;
+    __asm__ volatile(
+        "moveq #0,%[term]\n\t"
+        "add.w %[term],%[term]\n"
+        "1: move.w (%[modulus])+,%[term]\n\t"
+        "and.w %[borrow],%[term]\n\t"
+        "move.w (%[dst]),%[value]\n\t"
+        "addx.w %[term],%[value]\n\t"
+        "move.w %[value],(%[dst])+\n\t"
+        "dbra %[count],1b"
+        : [modulus] "+&a"(modulus), [dst] "+&a"(result),
+          [count] "+&d"(count), [term] "=&d"(term), [value] "=&d"(value)
+        : [borrow] "d"(borrow) : "cc", "memory");
+}
+#endif
