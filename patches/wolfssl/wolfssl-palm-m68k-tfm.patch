+#ifdef PALM_TFM_68K
+/* A 48-bit Comba column lives in one longword and one carry word. */
+static WC_INLINE __attribute__((always_inline)) void PalmCombaAdd(
+    fp_word* lo, fp_digit* hi, fp_word product)
+{
+    __asm__ ("add.l %2,%0\n\t"
+             "addx.w %3,%1"
+        : "+&d" (*lo), "+d" (*hi)
+        : "d" (product), "d" ((fp_digit)0) : "cc");
+}
+#endif
