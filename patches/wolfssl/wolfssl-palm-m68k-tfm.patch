+/* The P-256 prime has six consecutive zero digits and eight 0xffff digits in radix 2^16. */
+#if defined(PALM_TFM_68K) && defined(HAVE_ECC)
+static const fp_digit palmP256Prime[16] = {
+    0xffff, 0xffff, 0xffff, 0xffff, 0xffff, 0xffff, 0, 0,
+    0, 0, 0, 0, 1, 0, 0xffff, 0xffff
+};
+
+static WC_INLINE __attribute__((always_inline)) fp_digit PalmMontgomeryWord(
+    fp_digit* digit, fp_digit carry, fp_word product)
+{
+    fp_word sum = product + *digit + carry;
+    *digit = (fp_digit)sum;
+    return (fp_digit)(sum >> DIGIT_BIT);
+}
+
+static WC_INLINE __attribute__((always_inline)) fp_digit PalmP256MontgomeryRow(
+    fp_digit* row)
+{
+    fp_digit mu = row[0];
+    fp_word ones = ((fp_word)mu << DIGIT_BIT) - mu;
+    fp_digit carry = 0;
+    int i;
+    for (i = 0; i < 6; i++)
+        carry = PalmMontgomeryWord(&row[i], carry, ones);
+    for (; i < 12; i++)
+        carry = PalmMontgomeryWord(&row[i], carry, 0);
+    carry = PalmMontgomeryWord(&row[12], carry, mu);
+    carry = PalmMontgomeryWord(&row[13], carry, 0);
+    carry = PalmMontgomeryWord(&row[14], carry, ones);
+    return PalmMontgomeryWord(&row[15], carry, ones);
+}
+#endif
