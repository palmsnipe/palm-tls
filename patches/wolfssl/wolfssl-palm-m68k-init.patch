diff --git a/wolfcrypt/src/tfm.c b/wolfcrypt/src/tfm.c
--- a/wolfcrypt/src/tfm.c
+++ b/wolfcrypt/src/tfm.c
@@ -5168,7 +5168,9 @@
 void fp_init_copy(fp_int *a, const fp_int* b)
 {
     if (a != b) {
+#if !defined(PALM_TFM_68K) || defined(ALT_ECC_SIZE) || defined(HAVE_WOLF_BIGINT)
         fp_init(a);
+#endif
         /* Note reversed parameter order! */
         fp_copy(b, a); /* copy (src = b) to (dst = a) */
     }
