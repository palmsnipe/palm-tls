+/* Batch-invert the Z coordinates, then use the mixed-add sentinel Z == 0.
+ * The accumulator uses an explicit Montgomery Z, including after a copy. */
+static int PalmPublicNormalize(ecc_point** table, ecc_point* scratch,
+    mp_int* one, mp_int* modulus, mp_digit mp, void* heap)
+{
+    int count = 2 * PALM_P256_ODD_POINTS;
+    mp_int* prefix = (mp_int*)XMALLOC(count * sizeof(mp_int), heap,
+        DYNAMIC_TYPE_ECC);
+    mp_int* inverse = scratch->x;
+    mp_int* inverseZ = scratch->y;
+    mp_int* power = scratch->z;
+    int err;
+    int i;
+    (void)heap;
+
+    if (prefix == NULL)
+        return MP_MEM;
+    XMEMSET(prefix, 0, count * sizeof(mp_int));
+    err = mp_montgomery_calc_normalization(one, modulus);
+    if (err == MP_OKAY)
+        err = mp_copy(one, inverse);
+    for (i = 0; i < count && err == MP_OKAY; ++i) {
+        err = mp_copy(inverse, &prefix[i]);
+        if (err == MP_OKAY && !PalmPublicIsInfinity(table[i]))
+            err = PalmPublicProduct(inverse, table[i]->z, inverse, modulus, mp);
+    }
+    if (err == MP_OKAY)
+        err = mp_montgomery_reduce(inverse, modulus, mp);
+    if (err == MP_OKAY)
+        err = mp_invmod(inverse, modulus, inverse);
+    if (err == MP_OKAY)
+        err = mp_mulmod(inverse, one, modulus, inverse);
+    for (i = count - 1; i >= 0 && err == MP_OKAY; --i) {
+        ecc_point* point = table[i];
+        if (PalmPublicIsInfinity(point))
+            continue;
+        err = PalmPublicProduct(inverse, &prefix[i], inverseZ, modulus, mp);
+        if (err == MP_OKAY)
+            err = PalmPublicProduct(inverse, point->z, inverse, modulus, mp);
+        if (err == MP_OKAY)
+            err = PalmPublicSquare(inverseZ, power, modulus, mp);
+        if (err == MP_OKAY)
+            err = PalmPublicProduct(point->x, power, point->x, modulus, mp);
+        if (err == MP_OKAY)
+            err = PalmPublicProduct(power, inverseZ, power, modulus, mp);
+        if (err == MP_OKAY)
+            err = PalmPublicProduct(point->y, power, point->y, modulus, mp);
+        if (err == MP_OKAY)
+            mp_zero(point->z);
+    }
+    XFREE(prefix, heap, DYNAMIC_TYPE_ECC);
     return err;
 }
 
