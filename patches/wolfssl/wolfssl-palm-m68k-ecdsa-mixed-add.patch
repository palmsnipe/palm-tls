+/* Montgomery products used for public point preparation and verification. */
+static int PalmPublicProduct(mp_int* x, mp_int* y, mp_int* out,
+    mp_int* modulus, mp_digit mp)
+{
+    int err = mp_mul(x, y, out);
+    if (err == MP_OKAY)
+        err = mp_montgomery_reduce(out, modulus, mp);
+    return err;
+}
+
+static int PalmPublicSquare(mp_int* x, mp_int* out, mp_int* modulus, mp_digit mp)
+{
+    int err = mp_sqr(x, out);
+    if (err == MP_OKAY)
+        err = mp_montgomery_reduce(out, modulus, mp);
+    return err;
+}
